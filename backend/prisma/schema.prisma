model Notification {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// A message posted by a manager to the carer app. targetUserId null = shown to
// all carers; set = addressed to that one carer only.
model Announcement {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  title         String?
  body          String
  authorId      String?
  authorName    String
  targetUserId  String? // legacy single target; null = all carers, set = one carer
  // Multi-recipient targeting: JSON array of user ids. "[]" = broadcast to all
  // carers. When non-empty the message goes only to those carers (used when the
  // office selects several carers, e.g. everyone covering one client).
  targetUserIds String   @default("[]")
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([targetUserId])
}

// One-time link sent to a newly-created staff member so they can set
// their own password instead of a manager choosing one for them.
model PasswordSetupToken {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([companyId])
}

// Append-only record of sensitive changes (who did what, when).
model AuditLog {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  actorId   String?
  actorName String // snapshot of the actor's email/name at the time
  action    String // e.g. STAFF_UPDATED, PASSWORD_RESET, PERMISSIONS_UPDATED
  target    String? // human label of the affected thing
  details   String? // short human description of what changed
  createdAt DateTime @default(now())

  // Undo support: undoData is a JSON snapshot the reversal needs (e.g. the full
  // deleted visit rows for a SHIFT_DELETED entry). undoneAt/undoneById stamp when
  // and by whom it was undone; null undoneAt = still undoable.
  undoData   String?
  undoneAt   DateTime?
  undoneById String?

  @@index([createdAt])
  @@index([companyId])
}

// Per-company organisation settings — exactly one row per Company.
model OrgSettings {
  companyId             String?  @unique // one settings row per company
  id                    String   @id @default(cuid())
  companyName           String   @default("Caremid")
  logo                  String? // base64 data URL, used on reports/letterheads
  address               String?
  phone                 String?
  email                 String?
  cqcProviderId         String?
  icoNumber             String?
  timezone              String   @default("Europe/London")
  defaultHourlyRate     Float    @default(0)
  overtimeThreshold     Float    @default(40)
  inviteExpiryDays      Int      @default(7)
  // When false, carers can't request or accept shift swaps/cover — used to
  // freeze the rota while month-end hours are finalised for payroll.
  handoversEnabled      Boolean  @default(true)
  defaultRole           String   @default("EMPLOYEE")
  permissions           String   @default("{}") // JSON: { permissionKey: Role[] } overrides
  callLogTasks          String   @default("[]") // JSON: [{ id, label, phrase?, detail? }] carer-app visit checklist
  // When false, carers don't see the visit checklist and just free-write the note.
  callLogTasksEnabled   Boolean  @default(true)
  cqcSelfAssessment     String   @default("{}") // JSON: { statementKey: { rating, note } } manual CQC self-assessment
  // Regulation 13 asks for a named safeguarding lead, and a carer standing in
  // someone's hallway needs to know who that is without asking around.
  safeguardingLeadId    String?
  // Which local authority safeguarding teams this service refers to, and how.
  // Free text: a service covering three boroughs has three, each with its own
  // route in, and a dropdown would be a worse fit than a note.
  safeguardingContacts  String?
  staffFileRequirements String   @default("[]") // JSON: [{ id, label, hint, type, required, category?, minCount? }] editable staff-file compliance checklist
  trainingCourses       String   @default("[]") // JSON: string[] editable training-course list ('[]' = built-in defaults)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// Who pays for a service user's care: a local authority/council, a private
// self-funding client, or an NHS body. Reused across many service users.
model Funder {
  companyId        String? // tenant scope (app-enforced via Prisma extension)
  id               String   @id @default(cuid())
  name             String
  type             String   @default("PRIVATE") // COUNCIL | PRIVATE | NHS_CHC
  contactName      String?
  email            String?
  phone            String?
  billingAddress   String?
  poReference      String?
  paymentTermsDays Int      @default(30)
  vatExempt        Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fundingArrangements FundingArrangement[]
  invoices            Invoice[]

  @@index([companyId])
}

// Links a service user to a funder with a charge rate. The schema supports many
// per service user (for future split funding); v1 uses one funder each.
model FundingArrangement {
  companyId       String? // tenant scope (app-enforced via Prisma extension)
  id              String    @id @default(cuid())
  serviceUserId   String
  funderId        String
  billingUnit     String    @default("PER_HOUR") // PER_HOUR in v1
  rate            Float     @default(0) // base/weekday charge per hour (revenue, NOT carer pay)
  weekendRate     Float? // charge per hour on Sat/Sun; falls back to `rate` when null
  bankHolidayRate Float? // charge per hour on bank holidays; falls back to `rate` when null
  allocation      String    @default("ALL") // legacy; superseded by sharePercent
  sharePercent    Float     @default(100) // % of each visit billed to this funder (split funding)
  startDate       DateTime?
  endDate         DateTime?
  poNumber        String?
  contractRef     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  funder      Funder      @relation(fields: [funderId], references: [id], onDelete: Restrict)

  @@index([serviceUserId])
  @@index([funderId])
  @@index([companyId])
}

// Dates that count as bank holidays when picking a funding arrangement's rate.
// Seeded with England & Wales holidays; editable under Finances.
model BankHoliday {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())

  @@index([companyId])
}

// An invoice to a funder for a billing period, built from scheduled visits.
model Invoice {
  companyId   String? // tenant scope (app-enforced via Prisma extension)
  id          String    @id @default(cuid())
  funderId    String
  number      String? // assigned when finalised (e.g. INV-0001)
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | VOID
  issueDate   DateTime?
  dueDate     DateTime?
  subtotal    Float     @default(0)
  vat         Float     @default(0)
  total       Float     @default(0)
  poNumber    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  funder   Funder        @relation(fields: [funderId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]

  @@index([funderId])
  @@index([companyId])
}

// A payment received against an invoice. An invoice can have several (part
// payments); it is marked PAID once payments cover the total.
model Payment {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  date      DateTime @default(now())
  method    String? // BACS | CARD | CHEQUE | CASH | OTHER
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([companyId])
}

// One billed visit on an invoice. A visit can be split across funders, so it is
// billed at most once PER funder: the composite unique on (sourceShiftId,
// funderId) blocks double-billing the same visit to the same funder while
// still allowing each funder its share.
model InvoiceLine {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  invoiceId     String
  funderId      String? // denormalised from the invoice, for the per-funder unique
  serviceUserId String?
  sourceShiftId String?
  date          DateTime
  description   String
  quantity      Float    @default(0) // carer-hours billed to this funder (after share)
  unitRate      Float    @default(0)
  amount        Float    @default(0)
  createdAt     DateTime @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser? @relation(fields: [serviceUserId], references: [id], onDelete: SetNull)
  sourceShift Shift?       @relation(fields: [sourceShiftId], references: [id], onDelete: SetNull)

  @@unique([sourceShiftId, funderId])
  @@index([invoiceId])
  @@index([companyId])
}

// The complaints and compliments log (Regulation 16).
//
// One model for both, the way SafeguardingConcern carries whistleblowing: a
// compliment is received, recorded and shared, and the only difference is that
// there is nothing to investigate. A second near-identical module would cost
// more than the handful of fields a compliment leaves empty - and keeping them
// together is what makes "show me the feedback you had this year" answerable
// in one place.
//
// Not restricted to clients on the system. A neighbour can complain about a
// carer parking across their drive, and that is still a complaint.
model Complaint {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String  @id @default(cuid())
  // COMPLAINT | COMPLIMENT
  kind      String  @default("COMPLAINT")
  // The office's own reference, for quoting in a letter.
  reference String?

  // What it is about.
  serviceUserId   String?
  staffInvolvedId String?

  // Who raised it. A name is optional: an anonymous complaint is still a
  // complaint, and demanding a name is how they stop being recorded.
  complainantName    String?
  complainantContact String?
  // CLIENT | FAMILY | ADVOCATE | STAFF | PROFESSIONAL | COMMISSIONER | PUBLIC | ANONYMOUS | OTHER
  relationship       String  @default("CLIENT")
  // PHONE | EMAIL | LETTER | IN_PERSON | WEBSITE | SURVEY | OTHER
  channel            String  @default("PHONE")

  receivedById String
  receivedAt   DateTime  @default(now())
  occurredAt   DateTime?

  // What it is about, as a JSON array - one complaint often spans several,
  // and the categories are what make a trend report possible.
  categories String @default("[]")
  summary    String

  // --- Handling ---
  acknowledgedAt DateTime?
  investigation  String?

  // --- Outcome ---
  // UPHELD | PARTLY_UPHELD | NOT_UPHELD | WITHDRAWN
  outcome        String?
  respondedAt    DateTime?
  actionsTaken   String?
  lessonsLearned String?

  // --- Escalation ---
  // Signposting to the Local Government & Social Care Ombudsman is part of
  // responding, not a last resort: the person has to be told they can go
  // further before they can choose to.
  ombudsmanSignposted Boolean @default(false)
  escalatedToOmbudsman Boolean @default(false)
  ombudsmanReference  String?

  // OPEN | INVESTIGATING | RESPONDED | CLOSED
  status     String    @default("OPEN")
  closedAt   DateTime?
  closedById String?

  // R2 keys for letters and attachments. JSON array.
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  receivedBy    User         @relation("ComplaintReceiver", fields: [receivedById], references: [id], onDelete: Cascade)
  staffInvolved User?        @relation("ComplaintStaffInvolved", fields: [staffInvolvedId], references: [id], onDelete: SetNull)
  closedBy      User?        @relation("ComplaintCloser", fields: [closedById], references: [id], onDelete: SetNull)
  serviceUser   ServiceUser? @relation(fields: [serviceUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, receivedAt])
  @@index([companyId, kind])
  @@index([serviceUserId])
  @@index([receivedById])
}

// A mental capacity assessment (Mental Capacity Act 2005, and Reg 11).
//
// One row per DECISION. That is the whole point of the Act and the thing care
// records get wrong most often: capacity is not a property of a person, it is
// a question about one decision at one moment. A record saying "lacks
// capacity" with no decision named is the finding an inspector writes up, so
// this table cannot hold one - the decision is required.
//
// The Act's five principles are enforced rather than printed: capacity is
// presumed unless this record proves otherwise, an unwise decision is still
// the person's to make, and the controller refuses to record a finding of
// lacking capacity unless stage one, stage two and the practicable steps have
// all been answered.
model CapacityAssessment {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String  @id @default(cuid())
  serviceUserId String

  // The decision itself, in plain words: "whether to accept help with
  // washing", not "personal care".
  decision String
  // PERSONAL_CARE | MEDICATION | FINANCES | ACCOMMODATION | HEALTHCARE |
  // CONTACT | SAFETY | TECHNOLOGY | OTHER - for grouping only.
  category String @default("OTHER")

  assessedById String
  assessedAt   DateTime @default(now())

  // --- Stage 1: the diagnostic threshold ---
  // Is there an impairment of, or disturbance in, the functioning of the mind
  // or brain? If not, the person has capacity and stage two is never reached.
  impairment       Boolean @default(false)
  impairmentDetail String?

  // --- Principle 2: all practicable steps ---
  // Taken before concluding anyone cannot decide. The step most often skipped,
  // which is why it is its own required field rather than a tick.
  stepsTaken        String?
  bestTimeOfDay     String?
  communicationUsed String?

  // --- Stage 2: the functional test ---
  // Four separate abilities. Failing any ONE of them means the person cannot
  // make this decision at this time. Nullable: unanswered is not the same as
  // "no", and only a real answer can support a finding.
  canUnderstand  Boolean?
  canRetain      Boolean?
  canWeigh       Boolean?
  canCommunicate Boolean?
  evidence       String?

  // HAS_CAPACITY | LACKS_CAPACITY
  outcome    String?
  reviewDate DateTime?

  // --- Best interests (s4), only where capacity is lacking ---
  biOptions          String?
  biPersonsViews     String?
  biConsulted        String?
  biLeastRestrictive String?
  biDecision         String?
  biDecidedById      String?
  biDecidedAt        DateTime?

  // Would what is proposed amount to a deprivation of liberty? In someone's
  // own home that is a Court of Protection matter rather than DoLS, and the
  // thing that must be evidenced is that it was raised with somebody.
  deprivationConcern    Boolean   @default(false)
  deprivationRaisedWith String?
  deprivationRaisedAt   DateTime?
  deprivationReference  String?

  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  assessedBy  User        @relation("CapacityAssessor", fields: [assessedById], references: [id], onDelete: Cascade)
  biDecidedBy User?       @relation("CapacityDecider", fields: [biDecidedById], references: [id], onDelete: SetNull)

  @@index([companyId, serviceUserId])
  @@index([companyId, reviewDate])
  @@index([serviceUserId, assessedAt])
}

// Who may lawfully decide for this person, and whether anyone has actually
// looked at the paperwork.
//
// The gap an inspector finds is never "no LPA". It is that everyone believes a
// relative holds one, a carer has been taking instructions from them for a
// year, and nobody has seen the document or checked what it covers. So
// evidenceSeen is a field in its own right rather than an assumption.
model LegalAuthority {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String  @id @default(cuid())
  serviceUserId String

  // LPA_HEALTH | LPA_PROPERTY | DEPUTY_HEALTH | DEPUTY_PROPERTY |
  // APPOINTEE | COURT_ORDER | ADRT
  // ADRT has no holder - it is the person's own advance decision - and uses
  // holderName for where the document is kept.
  kind          String
  holderName    String?
  holderContact String?

  // Registered with the Office of the Public Guardian. An unregistered LPA
  // confers no authority at all, which is the detail most often missed.
  registered Boolean @default(false)
  reference  String?

  evidenceSeen     Boolean   @default(false)
  evidenceSeenAt   DateTime?
  evidenceSeenById String?

  // What it actually covers, and anything it does not.
  scope String?
  notes String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceUser    ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  evidenceSeenBy User?       @relation("AuthorityChecker", fields: [evidenceSeenById], references: [id], onDelete: SetNull)

  @@index([companyId, serviceUserId])
  @@index([serviceUserId, kind])
}

// The daily charts: food, fluid, repositioning, continence and skin.
//
// One table rather than five. They differ in which columns they use and in
// nothing else: all five are "a carer observed something about this person at
// this time", written on a doorstep in under ten seconds, and read back as a
// day or a week. Five tables would mean five controllers, five endpoints and
// five screens to keep in step, for records that are already answered by one
// question - what happened today.
//
// Every kind-specific column is nullable and `kind` decides which apply. The
// one number that gets totalled - fluid in millilitres - is a real column
// rather than JSON, because the whole point of a fluid chart is the running
// total against a target.
model CareChartEntry {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String  @id @default(cuid())
  serviceUserId String

  // FLUID | FOOD | REPOSITION | CONTINENCE | SKIN
  kind String

  recordedById String
  shiftId      String?
  // When it happened, which is not always when it was typed - a carer writes
  // up the 8am drink at 8.20 on the doorstep.
  occurredAt DateTime

  // FLUID: millilitres taken. The number the daily total is built from.
  amountMl Int?
  // FOOD: how much of what was offered was actually eaten.
  // NONE | QUARTER | HALF | THREE_QUARTERS | ALL
  portion String?
  // FOOD / FLUID: what was offered. SKIN: what was seen.
  description String?

  // REPOSITION: the position they were moved INTO.
  // BACK | LEFT | RIGHT | CHAIR | STANDING | WALKING | OTHER
  position String?

  // CONTINENCE: what happened.
  // URINE | BOWEL | BOTH | NONE | CATHETER
  continence String?
  // Was it continent, or an episode? Separate from the above because "used
  // the toilet" and "was wet" are different records of the same event type.
  incontinent Boolean @default(false)
  // Bristol stool scale, 1-7. Null unless a bowel movement was recorded.
  stoolScale Int?
  padChanged Boolean @default(false)

  // SKIN / REPOSITION: where on the body.
  bodySite String?
  // SKIN: what was found. INTACT | RED_BLANCHING | RED_NON_BLANCHING |
  // BROKEN | BLISTER | BRUISE | RASH | OTHER
  skinFinding String?

  // The person said no. Recorded rather than left blank: a refused drink and
  // a drink nobody offered look identical on a chart otherwise, and only one
  // of them is the carer's problem.
  refused Boolean @default(false)
  // Flagged for the office. Anything a carer thinks someone should look at.
  concern Boolean @default(false)
  notes   String?

  // R2 keys, for a skin photo.
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  recordedBy  User        @relation("ChartRecorder", fields: [recordedById], references: [id], onDelete: Cascade)

  // The query this table exists to answer: one person, one kind, one day.
  @@index([serviceUserId, kind, occurredAt])
  @@index([companyId, occurredAt])
  @@index([recordedById])
}

// The policy library (Reg 17).
//
// Three things make this a governance record rather than a folder of files:
// a version, a review date, and who has read it. The last one is the point.
// "We have a medication policy" is not an answer an inspector accepts; "here
// is version 3, issued in March, and here are the nineteen carers who signed
// it" is.
model Policy {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String  @id @default(cuid())

  title     String
  reference String?
  // SAFEGUARDING | MEDICATION | HEALTH_SAFETY | IPC | HR | DATA | CARE |
  // COMPLAINTS | BUSINESS_CONTINUITY | OTHER
  category String @default("OTHER")

  // Free text, a stored file, or both. Most providers have these as Word
  // documents already, so a link to the file has to be as good as pasting it.
  bodyText    String?
  attachments String  @default("[]")

  // Bumping this is what re-asks everyone. Acknowledgements are recorded
  // against the version signed, so a new version leaves the old signatures
  // standing as the record of what people agreed to at the time, and asks
  // again rather than quietly counting the old answer.
  version  String   @default("1.0")
  issuedAt DateTime @default(now())
  // Reg 17 does not name an interval. Annual is the convention, and an
  // overdue review is what the dashboard counts.
  reviewDate DateTime?

  // Who has to read it. ALL | CARERS | OFFICE | MANAGERS
  audience    String  @default("ALL")
  requiresAck Boolean @default(true)

  // DRAFT | ACTIVE | ARCHIVED
  status  String  @default("DRAFT")
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner           User?                   @relation("PolicyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  acknowledgements PolicyAcknowledgement[]

  @@index([companyId, status])
  @@index([companyId, reviewDate])
  @@index([companyId, category])
}

// One row per person per VERSION. Never updated - a signature is a fact about
// a moment, and re-signing a new version is a new fact rather than an edit to
// the old one.
model PolicyAcknowledgement {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String  @id @default(cuid())
  policyId  String
  userId    String
  version   String
  signedAt  DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // policyId is already unique to one company, so this needs no companyId of
  // its own to be safe across tenants. It exists to stop a double tap on a
  // bad signal recording two signatures.
  @@unique([policyId, userId, version])
  @@index([companyId, userId])
  @@index([policyId])
}

// A care audit (Reg 17).
//
// Not a checklist engine. What Reg 17 tests is that audits HAPPEN on a cycle,
// that they find things, and that the things found get fixed - so the record
// is the audit, its findings, and when the next one is due, with the real
// work carried by the actions it raises. A structured form per audit type
// would be a lot of scaffolding around the part that already works on paper.
model Audit {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String  @id @default(cuid())

  // CARE_PLAN | MAR | DAILY_NOTES | RECRUITMENT_FILE | CALL_MONITORING |
  // MEDICATION | SAFEGUARDING | IPC | HEALTH_SAFETY | COMPLAINTS | OTHER
  type  String
  title String?

  // What was looked at, and over what period. "Six care plans across two
  // sites" is the line that makes an audit checkable later.
  scope       String?
  periodStart DateTime?
  periodEnd   DateTime?

  auditedById String
  auditedAt   DateTime @default(now())

  // Optional, because not every audit scores. Where one does, the pair is
  // what makes two audits comparable.
  score    Int?
  maxScore Int?

  findings String?
  // When this audit should next run. The field the schedule is built from:
  // an audit with no next date is an audit that happened once.
  nextDueDate DateTime?

  // OPEN | COMPLETE
  status      String   @default("OPEN")
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditedBy User                @relation("Auditor", fields: [auditedById], references: [id], onDelete: Cascade)
  actions   ImprovementAction[]

  @@index([companyId, type])
  @@index([companyId, nextDueDate])
  @@index([companyId, auditedAt])
}

// The service improvement plan (Reg 17).
//
// One table for every action the service owes itself, wherever it came from:
// an audit, a complaint, a safeguarding concern, an incident, an inspection,
// or somebody noticing something. Keeping them together is the point - an
// improvement plan split by origin is five lists nobody reads as one, and
// "what are you doing about it" is a single question.
/// A manager's judgement on one CQC quality statement.
///
/// Every review is a NEW ROW, never an update. The latest row per statement
/// is the current position and the rest are the audit trail, which is what
/// Reg 17 actually asks for: who decided, when, and what changed. A single
/// mutable row would answer none of that.
model StatementReview {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String  @id @default(cuid())

  /// Key from lib/qualityStatements.ts, e.g. "safe_ipc".
  statementKey String
  /// MET | PARTIALLY_MET | NOT_MET. A manager cannot record "no evidence".
  status       String
  /// Why. Required - a rating with no reasoning is not an assessment.
  rationale    String
  /// Where the evidence lives: a document, a meeting, a survey.
  evidence     String?

  /// What the engine proposed at the time, kept so a divergence stays visible
  /// even after the data moves on.
  systemStatusAtReview String?

  reviewedById String
  reviewedAt   DateTime @default(now())

  reviewedBy User @relation("StatementReviewer", fields: [reviewedById], references: [id], onDelete: Cascade)

  @@index([companyId, statementKey])
  @@index([companyId, reviewedAt])
}

model ImprovementAction {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String  @id @default(cuid())

  title  String
  detail String?

  // AUDIT | COMPLAINT | SAFEGUARDING | INCIDENT | FEEDBACK | INSPECTION | OTHER
  source  String  @default("OTHER")
  auditId String?

  ownerId String?
  dueDate DateTime?
  // LOW | MEDIUM | HIGH
  priority String @default("MEDIUM")

  // OPEN | IN_PROGRESS | DONE | CANCELLED
  status String @default("OPEN")

  // What proves it was done. Required to close: an action marked done with
  // nothing behind it is the thing an inspector finds, because the plan then
  // reads as a list of good intentions.
  evidence      String?
  completedAt   DateTime?
  completedById String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  audit       Audit? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  owner       User?  @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy   User   @relation("ActionRaiser", fields: [createdById], references: [id], onDelete: Cascade)
  completedBy User?  @relation("ActionCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, dueDate])
  @@index([auditId])
  @@index([ownerId])
}
