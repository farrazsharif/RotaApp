generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A tenant: one care company that has signed up to the platform. Every
// piece of business data carries a companyId and is automatically scoped to
// the signed-in user's company, so companies can never see each other's data.
model Company {
  id         String  @id @default(cuid())
  name       String
  // URL-safe identifier used for the company's subdomain (slug.caremid.co.uk).
  slug       String  @unique
  // White-label branding shown inside the app for this company.
  logo       String? // base64 data URL
  brandColor String  @default("#2563eb")
  // Platform-level on/off switch (suspend a company without deleting data).
  active     Boolean @default(true)

  // --- Subscription / billing (Stripe) ---
  // Chosen plan shape: FLAT (fixed monthly) or PER_SEAT (per carer/staff).
  plan                 String    @default("FLAT") // FLAT | PER_SEAT
  // TRIALING | ACTIVE | PAST_DUE | CANCELED | INCOMPLETE
  subscriptionStatus   String    @default("TRIALING")
  trialEndsAt          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  seats                Int? // for PER_SEAT plans: billed carer count

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  companyId                String? // tenant scope (app-enforced via Prisma extension)
  id                       String    @id @default(cuid())
  email                    String    @unique
  password                 String
  firstName                String
  lastName                 String
  role                     String    @default("EMPLOYEE")
  customRoleId             String?
  // Per-person permission override (JSON array of capability keys). When set, it
  // fully replaces the role's permissions for this individual. Null = follow the
  // role (base matrix or custom role).
  permissionsOverride      String?
  hourlyRate               Float     @default(0)
  phone                    String?
  photo                    String? // profile picture as a base64 data URL
  active                   Boolean   @default(true)
  // Platform owner: can see the cross-company admin dashboard. Kept separate
  // from the per-company ADMIN role.
  platformAdmin            Boolean   @default(false)
  // Recruitment category — decides which staff-file documents are required.
  staffType                String    @default("LOCAL") // LOCAL | OVERSEAS
  // CARE = delivers the regulated activity; OFFICE = admin only. Scopes which
  // staff-file checks are required (see lib/staffCompliance).
  staffRole                String    @default("CARE")
  // Right to work check. The statutory excuse against an illegal-working civil
  // penalty comes from having CHECKED the documents before employment started,
  // not from holding a copy - so the date, method and who did it are recorded
  // here rather than inferred from an uploaded file.
  rightToWorkCheckedAt     DateTime?
  rightToWorkCheckedBy     String? // who carried out the check
  rightToWorkMethod        String? // MANUAL | IDVT | SHARE_CODE
  rightToWorkDocument      String? // what was seen, e.g. "UK passport"
  rightToWorkNote          String?
  // Staff-file checks marked not required for THIS person, with the reason.
  // JSON array of { requirementId, reason, by, at }. Kept as a waiver with a
  // stated reason rather than hiding the item, so the decision is auditable.
  complianceWaivers        String?
  // Not in scope for supervision or spot checks — an owner who delivers no
  // care, a registered manager supervised by the provider instead. Kept as a
  // flag with a STATED reason, and reported as "out of scope" rather than
  // silently dropped, because a smaller number nobody can explain is worse
  // than a bigger one that is right.
  // The day they started. Supervision is not chased in somebody's first
  // three months, and that window can only be worked out from a real start
  // date - createdAt is when the record was made, which for anybody added
  // in a bulk import is long after they actually joined.
  employmentStartDate      DateTime?
  supervisionExempt        Boolean   @default(false)
  supervisionExemptReason  String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  emergencyContactAddress  String?
  // Fit for Work Declaration (staff health questionnaire + signature),
  // stored as one JSON blob. See FitForWork type on the frontend.
  fitForWork               Json?
  // Employment Gap History Form (recruitment / vetting). The jobs are stored;
  // the gaps between them are worked out from the dates rather than typed a
  // second time, so a gap nobody wrote down cannot go unasked. See
  // lib/employmentHistory on the frontend.
  employmentHistory        Json?
  // DBS record (one current certificate per staff member) — mirrors the office
  // "DBS Database and Risk Assessment" register. All optional; blank until set.
  dbsCertificateNo         String?
  dbsPositionApplied       String?
  dbsDateOfIssue           DateTime?
  dbsRiskLevel             String? // Low | Medium | High
  dbsIssuedBy              String?
  dbsAppointingManager     String?
  dbsOffenceDisclosed      String? // free text, e.g. "N/A", "No", "Yes, Verbally"
  dbsOffenceDate           DateTime?
  dbsNotes                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  shifts             Shift[]
  coverShifts        Shift[]               @relation("ShiftCoverCarers")
  residentSlots      ShiftResidentSlot[]
  runs               Run[]                 @relation("RunCarers")
  timeOffRequests    TimeOffRequest[]
  clockRecords       ClockRecord[]
  notifications      Notification[]
  preferredBy        ServiceUser[]         @relation("PreferredCaregivers")
  callLogs           CallLog[]
  medAdministrations MedAdministration[]
  pushSubscriptions  PushSubscription[]
  familyLinks        FamilyLink[]
  trainings          Training[]
  importantDates     ImportantDate[]
  spotChecks         SpotCheck[]           @relation("SpotCheckCarer")
  incidentsReported  Incident[]            @relation("IncidentReporter")
  safeguardingRaised SafeguardingConcern[] @relation("SafeguardingRaiser")
  safeguardingAbout  SafeguardingConcern[] @relation("SafeguardingStaffInvolved")
  safeguardingClosed SafeguardingConcern[] @relation("SafeguardingCloser")
  complaintsReceived Complaint[]           @relation("ComplaintReceiver")
  complaintsAbout    Complaint[]           @relation("ComplaintStaffInvolved")
  complaintsClosed   Complaint[]           @relation("ComplaintCloser")
  // A machine's login, not a person's. Excluded from every count that means
  // "our staff": it has no DBS, no training and no supervision, and it is
  // not supposed to. Without this flag the agent account sits in the
  // compliance figures as a permanently non-compliant employee and in the
  // "still to sign" list of every policy.
  serviceAccount     Boolean               @default(false)
  chartEntries       CareChartEntry[]      @relation("ChartRecorder")
  policiesOwned      Policy[]              @relation("PolicyOwner")
  policySignatures   PolicyAcknowledgement[]
  auditsCarriedOut   Audit[]               @relation("Auditor")
  statementReviews   StatementReview[]     @relation("StatementReviewer")
  actionsOwned       ImprovementAction[]   @relation("ActionOwner")
  actionsRaised      ImprovementAction[]   @relation("ActionRaiser")
  actionsCompleted   ImprovementAction[]   @relation("ActionCompleter")
  capacityAssessed   CapacityAssessment[]  @relation("CapacityAssessor")
  capacityDecided    CapacityAssessment[]  @relation("CapacityDecider")
  authoritiesChecked LegalAuthority[]      @relation("AuthorityChecker")
  incidentsClosed    Incident[]            @relation("IncidentCloser")
  supervisions       Supervision[]         @relation("StaffSupervision")
  handoversSent      ShiftHandover[]       @relation("HandoverFrom")
  handoversReceived  ShiftHandover[]       @relation("HandoverTo")
  customRole         CustomRole?           @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  // Sites this user is scoped to / belongs to. Empty = org-wide (no restriction).
  sites              Site[]                @relation("UserSites")

  @@index([companyId])
}

// A named role an admin can create (e.g. "Senior Carer"). baseType decides
// fundamental app access (which of the 4 built-in account types it behaves
// like); permissions is a JSON array of capability keys for fine-grained
// control, overriding the base-role matrix for users assigned to it.
model CustomRole {
  companyId   String? // tenant scope (app-enforced via Prisma extension)
  id          String   @id @default(cuid())
  name        String
  baseType    String   @default("EMPLOYEE")
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Site {
  companyId           String? // tenant scope (app-enforced via Prisma extension)
  id                  String   @id @default(cuid())
  name                String   @unique
  color               String   @default("#3b82f6")
  order               Int      @default(0) // display order on the schedule (lower = first)
  // A supported-living scheme/house: clients on this site are supported-living,
  // and the scheme's housing provider (a separate company) is recorded here.
  supportedLiving     Boolean  @default(false)
  housingProvider     String?
  housingOfficerName  String?
  housingOfficerPhone String?
  housingOfficerEmail String?
  createdAt           DateTime @default(now())

  serviceUsers ServiceUser[]
  scopedUsers  User[]        @relation("UserSites")
  shifts       Shift[]

  @@index([companyId])
}

model ServiceUser {
  companyId                String? // tenant scope (app-enforced via Prisma extension)
  id                       String    @id @default(cuid())
  firstName                String
  lastName                 String
  dateOfBirth              DateTime
  serviceStartDate         DateTime?
  photo                    String? // profile picture as a base64 data URL
  siteId                   String?
  nhsNumber                String?
  packageId                String?
  grabSheet                String? // Emergency Grab Sheet fields (JSON)
  title                    String? // Mr / Mrs / Miss / Ms / Dr / Other
  preferredName            String?
  gender                   String?
  ethnicOrigin             String?
  address                  String?
  postcode                 String?
  keySafe                  String?
  medsSafeCode             String?
  phone                    String?
  email                    String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactMobile   String?
  emergencyContactAddress  String?
  emergencyContactRelation String?
  emergencyContactEmail    String?
  nextOfKinName            String?
  nextOfKinPhone           String?
  nextOfKinMobile          String?
  nextOfKinAddress         String?
  nextOfKinRelation        String?
  nextOfKinEmail           String?
  gpName                   String?
  gpPractice               String?
  gpPhone                  String?
  gpAddress                String?
  pharmacyName             String?
  pharmacyPhone            String?
  pharmacyAddress          String?
  needsMedication          Boolean   @default(false)
  needsMobility            Boolean   @default(false)
  needsPersonalCare        Boolean   @default(false)
  // Money handling: when true, carers can record financial transactions
  // (money spent on this client's behalf) during visits, and the office sees a
  // ledger. Off for most clients. financeOpeningBalance seeds the running balance.
  handlesMoney             Boolean   @default(false)
  financeOpeningBalance    Float     @default(0)
  careNotes                String?
  // Allergies, shown to a carer before they start. Null means NOBODY HAS
  // ASKED, which is not the same as none - so the form writes an explicit
  // "None known" rather than leaving this empty, and the CQC check counts
  // blanks.
  allergies                String?
  // Resuscitation status, and where the form physically is in the home: a
  // DNACPR nobody can find in the moment may as well not exist.
  // NONE | DNACPR | RESPECT
  dnacprStatus             String?
  dnacprLocation           String?
  // Accessible Information Standard: how this person needs information given
  // to them. JSON array of keys (large print, easy read, BSL, interpreter,
  // hearing loop...), with a free-text note for anything the list misses.
  communicationNeeds       String?
  communicationNotes       String?
  // Which daily charts this person is on. JSON array of CareChartEntry kinds
  // (FLUID, FOOD, REPOSITION, CONTINENCE, SKIN). Empty for most people: a
  // chart nobody needs is a chart that gets filled in without being read,
  // and four of them on every client would bury the ones that matter.
  careCharts               String    @default("[]")
  // Daily fluid target in millilitres. Without one a fluid chart is a list of
  // numbers nobody can call good or bad.
  fluidTargetMl            Int?
  // How often this person must be repositioned, in hours. Drives the overdue
  // warning on the repositioning chart.
  repositionHours          Int?
  contractedWeeklyHours    Float? // council-agreed hours of care per week (care package); null = not set
  visitDuration            Int       @default(30)
  visits                   String    @default("[]") // JSON array of { type, duration }
  // Per-visit care tasks the carer must do: JSON array of { name, description?, visit? }.
  // visit = the call name it belongs to (e.g. "Morning Call"); empty = every visit.
  careTasks                String    @default("[]")
  supportCategories        String    @default("[]") // JSON array of Capacity Tracker category labels
  active                   Boolean   @default(true)
  careType                 String    @default("DOMICILIARY") // DOMICILIARY (visit-based) | SUPPORTED_LIVING
  // Supported living — the housing provider is a separate company to the care
  // provider, so record the landlord/scheme details here.
  housingProvider          String? // landlord / housing association name
  housingScheme            String? // scheme / house name (for shared schemes)
  housingOfficerName       String?
  housingOfficerPhone      String?
  housingOfficerEmail      String?
  tenancyStartDate         DateTime?
  tenancyRef               String?
  status                   String    @default("ACTIVE") // ACTIVE, ON_HOLD, HOSPITALISED, DISCHARGED, DECEASED
  statusUpdatedAt          DateTime  @default(now()) // when the current status took effect (mirrors the latest statusChanges entry)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  site                 Site?                     @relation(fields: [siteId], references: [id])
  preferredCaregivers  User[]                    @relation("PreferredCaregivers")
  shifts               Shift[]
  residentSlots        ShiftResidentSlot[]
  callLogs             CallLog[]
  medications          Medication[]
  medAdministrations   MedAdministration[]
  carePlan             CarePlan?
  servicePlan          PersonalServicePlan?
  riskAssessments      RiskAssessment[]
  familyLinks          FamilyLink[]
  likesDislikes        LikesDislikes?
  reviews              Review[]
  fundingArrangements  FundingArrangement[]
  invoiceLines         InvoiceLine[]
  statusChanges        ServiceUserStatusChange[]
  spotChecks           SpotCheck[]
  incidents            Incident[]
  safeguardingConcerns SafeguardingConcern[]
  complaints           Complaint[]
  chartEntries         CareChartEntry[]
  capacityAssessments  CapacityAssessment[]
  legalAuthorities     LegalAuthority[]
  respitePeriods       RespitePeriod[]

  @@index([companyId])
}

// A respite / away period: the client is away (respite care, family, etc.) so
// no care is delivered and none of the visits in the window are chargeable.
// Creating one cancels the client's scheduled visits inside the window as
// non-chargeable; the period stays on record until a manager removes it.
model RespitePeriod {
  companyId         String? // tenant scope (app-enforced via Prisma extension)
  id                String   @id @default(cuid())
  serviceUserId     String
  startAt           DateTime // care pauses (the "away from" date & time)
  endAt             DateTime // care resumes (the "restart" date & time)
  note              String?
  type              String   @default("RESPITE") // RESPITE (planned away) | HOSPITAL (admission)
  cancelledShiftIds String   @default("[]") // JSON array of shift ids this period cancelled (for extend/reduce restore)
  cancelledCount    Int      @default(0) // visits cancelled when this period was created
  createdById       String?
  createdByName     String
  createdAt         DateTime @default(now())

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([serviceUserId])
}

// A timeline of a service user's status changes. Each entry takes effect at
// `effectiveAt` and stays in force until the next entry, so a shift shows the
// status that was in effect at that shift's own date+time — even after the
// status later changes again (e.g. hospitalised, then back to active).
model ServiceUserStatusChange {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String
  status        String // ACTIVE, ON_HOLD, HOSPITALISED, DISCHARGED, DECEASED
  effectiveAt   DateTime @default(now())
  changedById   String? // the staff user who made the change (if known)
  createdAt     DateTime @default(now())

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([serviceUserId, effectiveAt])
  @@index([companyId])
}

// A financial transaction a carer records on a client's behalf — money spent
// (amountOut) or received/topped up (amountIn) during a visit. Only for clients
// flagged handlesMoney. The office sees a running-balance ledger seeded by the
// client's financeOpeningBalance. Receipt photo lives in R2 under receiptKey; the
// patient's e-signature (or an "unable to sign" reason) is captured per
// transaction for audit. Scalar-only (no FK relations) to match the migration-
// free table bootstrap in ensureColumns.
model FinancialTransaction {
  companyId       String? // tenant scope (app-enforced via Prisma extension)
  id              String    @id @default(cuid())
  serviceUserId   String
  shiftId         String? // the visit it was recorded on, if any
  userId          String? // the carer who recorded it
  date            DateTime  @default(now())
  description     String
  amountIn        Float     @default(0) // money received / cash topped up (£)
  amountOut       Float     @default(0) // money spent on the client's behalf (£)
  receiptKey      String? // R2 object key for the receipt photo
  receiptName     String?
  clientSignature String? // patient e-signature JSON ({"kind":"esign",...}) or drawn data URL
  unableToSign    Boolean   @default(false)
  unableReason    String?
  // Office corrections: who last edited this entry and when. A money ledger
  // has to show that a figure was changed after the carer recorded it.
  editedAt        DateTime?
  editedById      String?
  editedByName    String? // denormalised so the ledger renders without a join
  createdAt       DateTime  @default(now())

  @@index([companyId])
  @@index([serviceUserId, date])
}

// An uploaded file (DBS certificate, contract, GP letter, etc.) attached to
// either a staff member (ownerType USER) or a service user (ownerType
// SERVICE_USER). The bytes live in Cloudflare R2 under storageKey; only
// metadata is kept here.
model Document {
  companyId    String? // tenant scope (app-enforced via Prisma extension)
  id           String    @id @default(cuid())
  ownerType    String // USER | SERVICE_USER
  ownerId      String
  category     String? // e.g. DBS, Contract, Reference, GP Letter
  // When this document stops being valid: a DBS, passport, visa, driving
  // licence or insurance certificate. Null for everything that doesn't expire
  // (contracts, references, offer letters), which is most of them. Recorded by
  // hand on upload - nothing reads a date out of the file itself.
  expiresAt    DateTime?
  fileName     String
  contentType  String
  size         Int
  storageKey   String // object key in the R2 bucket
  uploadedById String?
  createdAt    DateTime  @default(now())

  @@index([ownerType, ownerId])
  @@index([companyId])
  // Drives "what is about to lapse" across the whole company.
  @@index([companyId, expiresAt])
}

// Links a family-member User account to the service user(s) they're allowed
// to view read-only details for, via the separate family-portal app.
model FamilyLink {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  userId        String
  serviceUserId String
  relation      String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceUserId])
  @@index([companyId])
}

model PersonalServicePlan {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String   @unique
  data          String   @default("{}") // JSON: all assessment field values keyed by item id
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// A completed risk assessment for a client. One row per (serviceUser, type) so
// a client can hold several kinds (Environment, Bathing, Fire…). `data` is a
// JSON blob of field values keyed by item id — same shape as PersonalServicePlan.
model RiskAssessment {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String
  type          String // e.g. 'ENVIRONMENT'
  data          String   @default("{}")
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@unique([serviceUserId, type])
  @@index([companyId])
}

// Per-company template for the Personal Service Plan assessment — the editable
// list of sections and questions. One row per company; when absent the app
// falls back to the built-in default template. Stored as JSON so the flexible
// question shapes (and future additions) don't need schema changes.
model ServicePlanTemplate {
  companyId   String?  @unique // tenant scope (app-enforced via Prisma extension)
  id          String   @id @default(cuid())
  sections    String   @default("[]") // JSON array of { id, title, intro?, note?, action?, items: [...] }
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// An immutable, signed snapshot of a Personal Service Plan for the audit trail
// (CQC). Captures BOTH the questions (template) and the answers exactly as they
// were at sign-off, so a past version always prints as it was signed even after
// the template is later changed. Never edited or deleted.
model ServicePlanVersion {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String
  sections      String // JSON snapshot of the template (questions) at sign-off
  data          String // JSON snapshot of the answers at sign-off
  label         String? // review label, e.g. "6-week review", "Annual review"
  signedByName  String? // typed signatory (assessor / client / representative)
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([serviceUserId])
}

model CarePlanVersion {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String    @id @default(cuid())
  serviceUserId String
  data          String // JSON snapshot of the whole care plan at review time
  label         String? // review label, e.g. "Annual review"
  reviewDate    DateTime? // the next-review date recorded at the time of the review
  createdById   String?
  createdByName String
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([serviceUserId])
}

// Immutable dated snapshot of a completed Likes & Dislikes review. Freezes the
// whole stored Likes & Dislikes record at review time so past versions survive
// future edits. Never edited or deleted — only ever created.
model LikesDislikesVersion {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String    @id @default(cuid())
  serviceUserId String
  data          String // JSON snapshot of the whole Likes & Dislikes record at review time
  label         String? // review label, e.g. "Annual review"
  reviewDate    DateTime? // the next-review date recorded at the time of the review
  createdById   String?
  createdByName String
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([serviceUserId])
}

// Immutable dated snapshot of a completed Risk Assessment review. One shared
// table for the whole Risk Assessment family (Environment, Fire, Bathing, One
// Page Profile, Contract of Care, Supported Living Support Plan) — keyed by the
// `type` so a client can hold reviews of several kinds. Freezes the stored
// assessment's `data` at review time so past versions survive future edits.
// Never edited or deleted — only ever created.
model RiskAssessmentVersion {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String    @id @default(cuid())
  serviceUserId String
  type          String // which family member, e.g. 'ENVIRONMENT', 'CONTRACT_OF_CARE'
  data          String // JSON snapshot of the whole assessment at review time
  label         String? // review label, e.g. "Annual review"
  reviewDate    DateTime? // the next-review date recorded at the time of the review
  createdById   String?
  createdByName String
  createdAt     DateTime  @default(now())

  @@index([companyId])
  @@index([serviceUserId, type])
}

model ServiceUserNote {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String
  // GENERAL | COUNCIL | SOCIAL_WORK | SAFEGUARDING | CONTACT
  category      String   @default("GENERAL")
  body          String
  pinned        Boolean  @default(false)
  createdById   String?
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([serviceUserId])
}

model CarePlan {
  companyId       String? // tenant scope (app-enforced via Prisma extension)
  id              String    @id @default(cuid())
  serviceUserId   String    @unique
  // Weekly visit profile — JSON: { Monday: { morning, lunch, tea, bed }, ... }
  schedule        String    @default("{}")
  // Extra named calls beyond the four standard slots — JSON array of
  // { name, when } (e.g. Shopping, Domestic, GP appointment).
  extraCalls      String    @default("[]")
  // Tasks required at each visit
  tasksMorning    String?
  tasksLunch      String?
  tasksTea        String?
  tasksBed        String?
  // Custom task sections beyond the four standard slots — JSON array of
  // { title, tasks } (e.g. Shopping, Sitting service, Domestic).
  tasksExtra      String    @default("[]")
  numberOfCarers  String?
  carePackageInfo String?
  otherNotes      String?
  reviewDate      DateTime?
  // Legacy assessment-style fields (retained; now covered by the Personal Service Plan)
  summary         String?
  personalCare    String?
  mobility        String?
  nutrition       String?
  continence      String?
  medication      String?
  communication   String?
  mentalHealth    String?
  social          String?
  dailyRoutine    String?
  risks           String?
  goals           String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model LikesDislikes {
