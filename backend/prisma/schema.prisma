generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A tenant: one care company that has signed up to the platform. Every
// piece of business data carries a companyId and is automatically scoped to
// the signed-in user's company, so companies can never see each other's data.
model Company {
  id         String  @id @default(cuid())
  name       String
  // URL-safe identifier used for the company's subdomain (slug.caremid.co.uk).
  slug       String  @unique
  // White-label branding shown inside the app for this company.
  logo       String? // base64 data URL
  brandColor String  @default("#2563eb")
  // Platform-level on/off switch (suspend a company without deleting data).
  active     Boolean @default(true)

  // --- Subscription / billing (Stripe) ---
  // Chosen plan shape: FLAT (fixed monthly) or PER_SEAT (per carer/staff).
  plan                 String    @default("FLAT") // FLAT | PER_SEAT
  // TRIALING | ACTIVE | PAST_DUE | CANCELED | INCOMPLETE
  subscriptionStatus   String    @default("TRIALING")
  trialEndsAt          DateTime?
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  seats                Int? // for PER_SEAT plans: billed carer count

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  companyId                String? // tenant scope (app-enforced via Prisma extension)
  id                       String   @id @default(cuid())
  email                    String   @unique
  password                 String
  firstName                String
  lastName                 String
  role                     String   @default("EMPLOYEE")
  customRoleId             String?
  hourlyRate               Float    @default(0)
  phone                    String?
  photo                    String? // profile picture as a base64 data URL
  active                   Boolean  @default(true)
  // Platform owner: can see the cross-company admin dashboard. Kept separate
  // from the per-company ADMIN role.
  platformAdmin            Boolean  @default(false)
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  // Fit for Work Declaration (staff health questionnaire + signature),
  // stored as one JSON blob. See FitForWork type on the frontend.
  fitForWork               Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  shifts             Shift[]
  coverShifts        Shift[]             @relation("ShiftCoverCarers")
  timeOffRequests    TimeOffRequest[]
  clockRecords       ClockRecord[]
  notifications      Notification[]
  preferredBy        ServiceUser[]       @relation("PreferredCaregivers")
  callLogs           CallLog[]
  medAdministrations MedAdministration[]
  pushSubscriptions  PushSubscription[]
  familyLinks        FamilyLink[]
  trainings          Training[]
  importantDates     ImportantDate[]
  spotChecks         SpotCheck[]         @relation("SpotCheckCarer")
  customRole         CustomRole?         @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  // Sites this user is scoped to / belongs to. Empty = org-wide (no restriction).
  sites              Site[]              @relation("UserSites")

  @@index([companyId])
}

// A named role an admin can create (e.g. "Senior Carer"). baseType decides
// fundamental app access (which of the 4 built-in account types it behaves
// like); permissions is a JSON array of capability keys for fine-grained
// control, overriding the base-role matrix for users assigned to it.
model CustomRole {
  companyId   String? // tenant scope (app-enforced via Prisma extension)
  id          String   @id @default(cuid())
  name        String
  baseType    String   @default("EMPLOYEE")
  permissions String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Site {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())

  serviceUsers ServiceUser[]
  scopedUsers  User[]        @relation("UserSites")

  @@index([companyId])
}

model ServiceUser {
  companyId                String? // tenant scope (app-enforced via Prisma extension)
  id                       String   @id @default(cuid())
  firstName                String
  lastName                 String
  dateOfBirth              DateTime
  photo                    String? // profile picture as a base64 data URL
  siteId                   String?
  nhsNumber                String?
  preferredName            String?
  gender                   String?
  ethnicOrigin             String?
  address                  String?
  postcode                 String?
  keySafe                  String?
  medsSafeCode             String?
  phone                    String?
  email                    String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactMobile   String?
  emergencyContactAddress  String?
  emergencyContactRelation String?
  nextOfKinName            String?
  nextOfKinPhone           String?
  nextOfKinMobile          String?
  nextOfKinAddress         String?
  nextOfKinRelation        String?
  gpName                   String?
  gpPractice               String?
  gpPhone                  String?
  gpAddress                String?
  pharmacyName             String?
  pharmacyPhone            String?
  pharmacyAddress          String?
  needsMedication          Boolean  @default(false)
  needsMobility            Boolean  @default(false)
  needsPersonalCare        Boolean  @default(false)
  careNotes                String?
  visitDuration            Int      @default(30)
  visits                   String   @default("[]") // JSON array of { type, duration }
  active                   Boolean  @default(true)
  status                   String   @default("ACTIVE") // ACTIVE, ON_HOLD, HOSPITALISED, DISCHARGED, DECEASED
  statusUpdatedAt          DateTime @default(now()) // when the current status took effect (mirrors the latest statusChanges entry)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  site                Site?                @relation(fields: [siteId], references: [id])
  preferredCaregivers User[]               @relation("PreferredCaregivers")
  shifts              Shift[]
  callLogs            CallLog[]
  medications         Medication[]
  medAdministrations  MedAdministration[]
  carePlan            CarePlan?
  servicePlan         PersonalServicePlan?
  familyLinks         FamilyLink[]
  likesDislikes       LikesDislikes?
  reviews             Review[]
  fundingArrangements FundingArrangement[]
  invoiceLines        InvoiceLine[]
  statusChanges       ServiceUserStatusChange[]
  spotChecks          SpotCheck[]

  @@index([companyId])
}

// A timeline of a service user's status changes. Each entry takes effect at
// `effectiveAt` and stays in force until the next entry, so a shift shows the
// status that was in effect at that shift's own date+time — even after the
// status later changes again (e.g. hospitalised, then back to active).
model ServiceUserStatusChange {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String
  status        String // ACTIVE, ON_HOLD, HOSPITALISED, DISCHARGED, DECEASED
  effectiveAt   DateTime @default(now())
  changedById   String? // the staff user who made the change (if known)
  createdAt     DateTime @default(now())

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([serviceUserId, effectiveAt])
  @@index([companyId])
}

// An uploaded file (DBS certificate, contract, GP letter, etc.) attached to
// either a staff member (ownerType USER) or a service user (ownerType
// SERVICE_USER). The bytes live in Cloudflare R2 under storageKey; only
// metadata is kept here.
model Document {
  companyId    String? // tenant scope (app-enforced via Prisma extension)
  id           String   @id @default(cuid())
  ownerType    String // USER | SERVICE_USER
  ownerId      String
  category     String? // e.g. DBS, Contract, Reference, GP Letter
  fileName     String
  contentType  String
  size         Int
  storageKey   String // object key in the R2 bucket
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([companyId])
}

// Links a family-member User account to the service user(s) they're allowed
// to view read-only details for, via the separate family-portal app.
model FamilyLink {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  userId        String
  serviceUserId String
  relation      String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceUserId])
  @@index([companyId])
}

model PersonalServicePlan {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String   @unique
  data          String   @default("{}") // JSON: all assessment field values keyed by item id
  updatedById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CarePlan {
  companyId       String? // tenant scope (app-enforced via Prisma extension)
  id              String    @id @default(cuid())
  serviceUserId   String    @unique
  // Weekly visit profile — JSON: { Monday: { morning, lunch, tea, bed }, ... }
  schedule        String    @default("{}")
  // Tasks required at each visit
  tasksMorning    String?
  tasksLunch      String?
  tasksTea        String?
  tasksBed        String?
  numberOfCarers  String?
  carePackageInfo String?
  otherNotes      String?
  reviewDate      DateTime?
  // Legacy assessment-style fields (retained; now covered by the Personal Service Plan)
  summary         String?
  personalCare    String?
  mobility        String?
  nutrition       String?
  continence      String?
  medication      String?
  communication   String?
  mentalHealth    String?
  social          String?
  dailyRoutine    String?
  risks           String?
  goals           String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model LikesDislikes {
  companyId      String? // tenant scope (app-enforced via Prisma extension)
  id             String   @id @default(cuid())
  serviceUserId  String   @unique
  likes          String?
  dislikes       String?
  lifeHistory    String? // "A little of my life history"
  health         String? // "My health"
  whatPeopleLike String? // "What might people like about me?"
  relationships  String?
  goodDay        String? // "What makes a good day for me"
  badDay         String? // "What makes a bad day for me"
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// 6-week (and subsequent) service review. Question answers are stored as
// JSON keyed by question id: { q1: { answer: "YES"|"NO"|"NA", comment: "" } }.
// Agreed outcomes is a JSON array: [{ action, outcome, timescale, actionBy, completion }].
model Review {
  companyId          String? // tenant scope (app-enforced via Prisma extension)
  id                 String    @id @default(cuid())
  serviceUserId      String
  // "SIX_WEEK" (once, ~6 weeks after service start) or "QUARTERLY" (recurring)
  type               String    @default("SIX_WEEK")
  reviewDate         DateTime
  // When the next (quarterly) review is due — drives the overdue alert.
  nextReviewDate     DateTime?
  assessorName       String?
  answers            String    @default("{}")
  otherInfo          String?
  outcomes           String    @default("[]")
  representativeName String?
  phoneConsent       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// A field-supervisor spot check: observing a carer on a visit against a
// checklist, with general comments and the observer's signature. Answers are
// JSON keyed by item id: { itemId: { answer: "YES"|"NO"|"NA", comment } }.
model SpotCheck {
  companyId         String? // tenant scope (app-enforced via Prisma extension)
  id                String   @id @default(cuid())
  carerId           String
  serviceUserId     String?
  date              DateTime
  time              String?
  location          String?
  answers           String   @default("{}")
  generalComments   String?
  observerId        String?
  observerName      String?
  observerSignature String? // drawn signature as a data URL
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  carer       User         @relation("SpotCheckCarer", fields: [carerId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser? @relation(fields: [serviceUserId], references: [id], onDelete: SetNull)

  @@index([carerId, date])
  @@index([companyId])
}

// A shared office log — short daily updates about staff, service users and
// office activities, written by admins/managers and shown on the dashboard.
model OfficeNote {
  companyId  String? // tenant scope (app-enforced via Prisma extension)
  id         String   @id @default(cuid())
  body       String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())

  @@index([companyId])
}

// Training course attended by a staff member, e.g. "First Aid", with an
// optional expiry so managers can see at a glance who needs renewal.
model Training {
  companyId   String? // tenant scope (app-enforced via Prisma extension)
  id          String    @id @default(cuid())
  userId      String
  course      String
  date        DateTime
  expiresAt   DateTime?
  accredited  Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Generic recurring/one-off important date for a staff member — DBS renewal,
// supervision, appraisal, contract review, etc.
model ImportantDate {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  userId    String
  label     String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Medication {
  companyId        String? // tenant scope (app-enforced via Prisma extension)
  id               String    @id @default(cuid())
  serviceUserId    String
  name             String
  dose             String?
  route            String?
  instructions     String?
  times            String    @default("[]") // JSON array of "HH:MM" dose times
  // JSON array of { view: 'front'|'back'|'faceFront'|'faceSide', x, y } body-map
  // points (x/y as % of the diagram) — where a cream/lotion should be applied.
  applicationSites String    @default("[]")
  startDate        DateTime?
  endDate          DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  serviceUser     ServiceUser         @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  administrations MedAdministration[]

  @@index([companyId])
}

model MedAdministration {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  medicationId  String
  serviceUserId String
  userId        String?
  scheduledFor  DateTime
  status        String // GIVEN, REFUSED, MISSED, NOT_NEEDED, SELF_ADMIN
  note          String?
  recordedAt    DateTime @default(now())

  medication  Medication  @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([medicationId, scheduledFor])
  @@index([companyId])
}

model Shift {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  userId        String?
  serviceUserId String?
  seriesId      String?
  date          DateTime
  startTime     String
  endTime       String
  visitName     String?
  cover         Int      @default(1)
  role          String?
  notes         String?
  status        String   @default("SCHEDULED")
  // Defaults true at the DB level so pre-existing shifts stay visible to
  // carers; newly created shifts are explicitly set to false by the
  // controller until a manager publishes them.
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coverCarers  User[]        @relation("ShiftCoverCarers")
  serviceUser  ServiceUser?  @relation(fields: [serviceUserId], references: [id])
  clockRecords ClockRecord[]
  callLogs     CallLog[]
  invoiceLines InvoiceLine[]

  @@index([companyId])
}

model CallLog {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  shiftId       String?
  serviceUserId String
  userId        String?
  note          String
  createdAt     DateTime @default(now())

  shift       Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
}

model TimeOffRequest {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime
  endDate   DateTime
  type      String
  reason    String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ClockRecord {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String    @id @default(cuid())
  userId    String
  shiftId   String?
  clockIn   DateTime
  clockOut  DateTime?
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shift Shift? @relation(fields: [shiftId], references: [id])

  @@index([companyId])
}

model PushSubscription {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// Tracks which shift-reminder pushes have already been sent so the
// reminder poller (which runs every minute) never double-sends.
model ShiftReminder {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  shiftId   String
  userId    String
  type      String // "BEFORE" (30 mins before) | "START" (at call start)
  sentAt    DateTime @default(now())

  @@unique([shiftId, userId, type])
  @@index([companyId])
}

model Notification {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// One-time link sent to a newly-created staff member so they can set
// their own password instead of a manager choosing one for them.
model PasswordSetupToken {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([companyId])
}

// Append-only record of sensitive changes (who did what, when).
model AuditLog {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  actorId   String?
  actorName String // snapshot of the actor's email/name at the time
  action    String // e.g. STAFF_UPDATED, PASSWORD_RESET, PERMISSIONS_UPDATED
  target    String? // human label of the affected thing
  details   String? // short human description of what changed
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([companyId])
}

// Per-company organisation settings — exactly one row per Company.
model OrgSettings {
  companyId         String?  @unique // one settings row per company
  id                String   @id @default(cuid())
  companyName       String   @default("Caremid")
  logo              String? // base64 data URL, used on reports/letterheads
  address           String?
  phone             String?
  email             String?
  cqcProviderId     String?
  icoNumber         String?
  timezone          String   @default("Europe/London")
  defaultHourlyRate Float    @default(0)
  overtimeThreshold Float    @default(40)
  inviteExpiryDays  Int      @default(7)
  defaultRole       String   @default("EMPLOYEE")
  permissions       String   @default("{}") // JSON: { permissionKey: Role[] } overrides
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Who pays for a service user's care: a local authority/council, a private
// self-funding client, or an NHS body. Reused across many service users.
model Funder {
  companyId        String? // tenant scope (app-enforced via Prisma extension)
  id               String   @id @default(cuid())
  name             String
  type             String   @default("PRIVATE") // COUNCIL | PRIVATE | NHS_CHC
  contactName      String?
  email            String?
  phone            String?
  billingAddress   String?
  poReference      String?
  paymentTermsDays Int      @default(30)
  vatExempt        Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  fundingArrangements FundingArrangement[]
  invoices            Invoice[]

  @@index([companyId])
}

// Links a service user to a funder with a charge rate. The schema supports many
// per service user (for future split funding); v1 uses one funder each.
model FundingArrangement {
  companyId       String? // tenant scope (app-enforced via Prisma extension)
  id              String    @id @default(cuid())
  serviceUserId   String
  funderId        String
  billingUnit     String    @default("PER_HOUR") // PER_HOUR in v1
  rate            Float     @default(0) // base/weekday charge per hour (revenue, NOT carer pay)
  weekendRate     Float? // charge per hour on Sat/Sun; falls back to `rate` when null
  bankHolidayRate Float? // charge per hour on bank holidays; falls back to `rate` when null
  allocation      String    @default("ALL") // legacy; superseded by sharePercent
  sharePercent    Float     @default(100) // % of each visit billed to this funder (split funding)
  startDate       DateTime?
  endDate         DateTime?
  poNumber        String?
  contractRef     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)
  funder      Funder      @relation(fields: [funderId], references: [id], onDelete: Restrict)

  @@index([serviceUserId])
  @@index([funderId])
  @@index([companyId])
}

// Dates that count as bank holidays when picking a funding arrangement's rate.
// Seeded with England & Wales holidays; editable under Finances.
model BankHoliday {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  date      DateTime @unique
  name      String
  createdAt DateTime @default(now())

  @@index([companyId])
}

// An invoice to a funder for a billing period, built from scheduled visits.
model Invoice {
  companyId   String? // tenant scope (app-enforced via Prisma extension)
  id          String    @id @default(cuid())
  funderId    String
  number      String? // assigned when finalised (e.g. INV-0001)
  periodStart DateTime
  periodEnd   DateTime
  status      String    @default("DRAFT") // DRAFT | SENT | PAID | VOID
  issueDate   DateTime?
  dueDate     DateTime?
  subtotal    Float     @default(0)
  vat         Float     @default(0)
  total       Float     @default(0)
  poNumber    String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  funder   Funder        @relation(fields: [funderId], references: [id], onDelete: Restrict)
  lines    InvoiceLine[]
  payments Payment[]

  @@index([funderId])
  @@index([companyId])
}

// A payment received against an invoice. An invoice can have several (part
// payments); it is marked PAID once payments cover the total.
model Payment {
  companyId String? // tenant scope (app-enforced via Prisma extension)
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  date      DateTime @default(now())
  method    String? // BACS | CARD | CHEQUE | CASH | OTHER
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([companyId])
}

// One billed visit on an invoice. A visit can be split across funders, so it is
// billed at most once PER funder: the composite unique on (sourceShiftId,
// funderId) blocks double-billing the same visit to the same funder while
// still allowing each funder its share.
model InvoiceLine {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  invoiceId     String
  funderId      String? // denormalised from the invoice, for the per-funder unique
  serviceUserId String?
  sourceShiftId String?
  date          DateTime
  description   String
  quantity      Float    @default(0) // carer-hours billed to this funder (after share)
  unitRate      Float    @default(0)
  amount        Float    @default(0)
  createdAt     DateTime @default(now())

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser? @relation(fields: [serviceUserId], references: [id], onDelete: SetNull)
  sourceShift Shift?       @relation(fields: [sourceShiftId], references: [id], onDelete: SetNull)

  @@unique([sourceShiftId, funderId])
  @@index([invoiceId])
  @@index([companyId])
}
