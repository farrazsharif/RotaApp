// A live-in care placement: one carer living in a client's home for a block of
// days. The live-in equivalent of a "call". Scalar refs (no DB FK) so the deploy
// stays migration-free; the app resolves carer/client via the scalar ids.
model Placement {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String
  carerId       String
  startDate     DateTime // first day of the placement (date-only, midnight)
  endDate       DateTime // last day of the placement (inclusive, date-only)
  nightType     String   @default("SLEEP_IN") // SLEEP_IN | WAKING
  status        String   @default("SCHEDULED") // SCHEDULED | ACTIVE | COMPLETED | CANCELLED
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId])
  @@index([serviceUserId])
  @@index([carerId])
}

// A single timestamped entry in a supported-living running support log. Workers
// add many of these through a shift as they complete tasks (a diary), rather
// than one note at the end. Scalar refs (no DB FK), author name denormalised.
model SupportLogEntry {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  serviceUserId String
  shiftId       String?
  userId        String?
  userName      String // denormalised author name for display
  body          String
  domains       String   @default("[]") // JSON array of support-domain keys
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([serviceUserId])
  @@index([shiftId])
}

// A live-in carer's daily diary entry for a placement — one row per (placement,
// day). `data` is a JSON blob of the day's record (personal care, meals, mood,
// meds, night, incidents, notes). Scalar refs, no DB FK (migration-free).
model LiveInDailyLog {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  placementId   String
  serviceUserId String
  carerId       String
  date          DateTime // date-only (midnight)
  data          String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([placementId, date])
  @@index([companyId])
  @@index([placementId])
}

// 6-week (and subsequent) service review. Question answers are stored as
// JSON keyed by question id: { q1: { answer: "YES"|"NO"|"NA", comment: "" } }.
// Agreed outcomes is a JSON array: [{ action, outcome, timescale, actionBy, completion }].
model Review {
  companyId          String? // tenant scope (app-enforced via Prisma extension)
  id                 String    @id @default(cuid())
  serviceUserId      String
  // "SIX_WEEK" (once, ~6 weeks after service start) or "QUARTERLY" (recurring)
  type               String    @default("SIX_WEEK")
  reviewDate         DateTime
  // When the next (quarterly) review is due — drives the overdue alert.
  nextReviewDate     DateTime?
  assessorName       String?
  answers            String    @default("{}")
  otherInfo          String?
  outcomes           String    @default("[]")
  representativeName String?
  phoneConsent       Boolean   @default(false)
  // Signatures: a drawn PNG data URL, an {"kind":"esign",...} JSON string, or empty.
  serviceUserSig     String?
  supervisorSig      String?
  // "form" = full digital review; "paper" = historic date-only entry seeding the schedule.
  source             String    @default("form")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// A field-supervisor spot check: observing a carer on a visit against a
// checklist, with general comments and the observer's signature. Answers are
// JSON keyed by item id: { itemId: { answer: "YES"|"NO"|"NA", comment } }.
// An accident, incident or near miss. One record, filled in two passes:
//
//   The carer reports it from their phone, at the time, in their own words:
//   what happened, who was hurt, what they did about it, who they told. That
//   is all a carer standing in a hallway can reasonably be asked for.
//
//   The office then investigates over the following days and completes the
//   checklist in `investigation` - Care 24's Accident & Incident Form, which
//   follows the HSE investigation checklist: securing the scene, witnesses,
//   root causes, RIDDOR, whether the actions taken actually worked.
//
// Keeping both halves on one row matters: a report with no investigation is
// visibly an open incident, which is exactly what an inspector looks for.
// One required carer for one resident on a house shift.
//
// A house can mix funded ratios: resident A on 2:1 and resident B on 1:1 means
// three carers on site, but "cover: 3" alone cannot evidence that two of them
// are A's. One row per required carer records the ratio, and `userId` records
// who is filling it — so hours attribute to the right resident for invoicing,
// and the schedule can say "A still needs 1 more" rather than just "needs 1".
//
// A carer in a slot is NOT restricted to that resident: on shift they cover
// each other's breaks, and the resident switcher lets anyone on the house log
// for anyone in it. The slot is about funding and staffing levels, not about
// who may enter a record.
model ShiftResidentSlot {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String   @id @default(cuid())
  shiftId       String
  serviceUserId String
  // The carer filling this slot. Null = the slot is still unfilled, which is
  // what the schedule counts as "needs another carer" for this resident.
  userId        String?
  // This carer's own hours on the house shift, when they differ from the
  // visit's. Null on both means they work the visit's times - which is what
  // every existing row does. A house is covered across the day by carers on
  // staggered shifts (7-3 and 2-10 on the same house), and before this they
  // all had to share one pair of times.
  startTime     String?
  endTime       String?
  createdAt     DateTime @default(now())

  shift       Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  serviceUser ServiceUser @relation(fields: [serviceUserId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([shiftId])
  @@index([companyId, serviceUserId])
  @@index([userId])
}

model SafeguardingConcern {
  companyId     String? // tenant scope (app-enforced via Prisma extension)
  id            String  @id @default(cuid())
  // CONCERN | WHISTLEBLOWING. The same record: both are raised, investigated,
  // outcomed and closed, and both answer to the same "show me one" question.
  // A whistleblowing disclosure is about the organisation rather than a named
  // person at risk, so personAtRisk and harmTypes simply go unused there -
  // which is a better trade than a second near-identical module.
  kind          String  @default("CONCERN")
  // Identity withheld. A disclosure made in confidence stays that way on the
  // screen too, or the log becomes the reason nobody uses it.
  confidential  Boolean @default(false)
  // Who is at risk. Usually a client, but a concern can be about a member of
  // staff, a family member or someone else in the home - so the link is
  // optional and a free-text name carries the rest. A concern that cannot be
  // recorded because the person is not on the system is a concern that goes
  // unrecorded.
  serviceUserId String?
  personAtRisk  String?
  // Who entered it, and - when different - who actually raised it: a relative,
  // a district nurse, an anonymous caller.
  raisedById    String
  raisedByName  String?
  // CARER | FAMILY | CLIENT | PROFESSIONAL | ANONYMOUS | OFFICE | OTHER
  source        String  @default("CARER")

  occurredAt DateTime?
  raisedAt   DateTime  @default(now())

  // The Care Act 2014 categories of abuse and neglect. JSON array: a single
  // concern often spans more than one.
  harmTypes       String  @default("[]")
  description     String
  immediateAction String?

  // A staff member the concern is ABOUT. Deliberately separate from
  // raisedById so "who reported it" and "who it concerns" can never blur.
  staffInvolvedId String?

  // --- Referral to the local authority safeguarding team ---
  referredToLA   Boolean   @default(false)
  laName         String?
  laReference    String?
  laReferralDate DateTime?

  // --- Statutory notification to CQC (Registration Reg 18) ---
  cqcNotified     Boolean   @default(false)
  cqcNotifiedDate DateTime?
  cqcReference    String?

  // --- Police ---
  policeInformed  Boolean @default(false)
  policeReference String?

  // OPEN | INVESTIGATING | REFERRED | CLOSED
  status         String    @default("OPEN")
  outcome        String?
  lessonsLearned String?
  closedAt       DateTime?
  closedById     String?

  // R2 keys for anything attached. JSON array.
  attachments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  raisedBy      User         @relation("SafeguardingRaiser", fields: [raisedById], references: [id], onDelete: Cascade)
  staffInvolved User?        @relation("SafeguardingStaffInvolved", fields: [staffInvolvedId], references: [id], onDelete: SetNull)
  closedBy      User?        @relation("SafeguardingCloser", fields: [closedById], references: [id], onDelete: SetNull)
  serviceUser   ServiceUser? @relation(fields: [serviceUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, raisedAt])
  @@index([serviceUserId])
  @@index([raisedById])
}

model Incident {
  companyId         String? // tenant scope (app-enforced via Prisma extension)
  id                String    @id @default(cuid())
  // Nullable: not every incident involves a client (a carer hurt on a
  // doorstep still has to be recorded), and not every one happens on a visit.
  serviceUserId     String?
  shiftId           String?
  reportedById      String
  occurredAt        DateTime
  // ACCIDENT | INCIDENT | NEAR_MISS
  kind              String    @default("ACCIDENT")
  category          String?
  whatHappened      String
  injuries          String?
  immediateAction   String?
  whoInformed       String?
  witnesses         String?
  emergencyServices Boolean   @default(false)
  // Photos and the like, as R2 keys. JSON array.
  attachments       String    @default("[]")
  // The office investigation checklist answers, keyed like the risk
  // assessment forms. JSON.
  investigation     String    @default("{}")
  // Duty of candour (Reg 20). Nullable boolean: null means nobody has decided
  // yet, which is the state the dashboard chases. False means considered and
  // not required, which is a complete answer.
  candourRequired   Boolean?
  // NONE | LOW | MODERATE | SEVERE | DEATH | PSYCHOLOGICAL
  candourHarm       String?
  candourToldAt     DateTime?
  candourToldWho    String?
  candourApology    Boolean   @default(false)
  candourWrittenAt  DateTime?
  candourOutcomeAt  DateTime?
  candourNotes      String?
  // RIDDOR, which rides along with candour because the same office decision
  // produces both.
  riddorRequired    Boolean?
  riddorReportedAt  DateTime?
  riddorRef         String?
  // REPORTED | INVESTIGATING | CLOSED
  status            String    @default("REPORTED")
  closedAt          DateTime?
  closedById        String?
  closedSignature   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  reportedBy  User         @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Cascade)
  closedBy    User?        @relation("IncidentCloser", fields: [closedById], references: [id], onDelete: SetNull)
  serviceUser ServiceUser? @relation(fields: [serviceUserId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, candourRequired])
  @@index([serviceUserId, occurredAt])
  @@index([reportedById])
}

model SpotCheck {
  companyId         String? // tenant scope (app-enforced via Prisma extension)
  id                String   @id @default(cuid())
  carerId           String
