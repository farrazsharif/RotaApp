DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Email (use Ethereal for testing: https://ethereal.email)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="your-ethereal-user"
SMTP_PASS="your-ethereal-pass"
SMTP_FROM="Caremid <noreply@caremid.co.uk>"

# Stripe billing (optional — leave blank to run without online payments).
# Create two recurring Prices in the Stripe dashboard: a flat monthly price and
# a per-unit (per carer) monthly price, then paste their price IDs here.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_FLAT=""
STRIPE_PRICE_PER_SEAT=""
